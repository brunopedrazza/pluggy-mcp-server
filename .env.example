# Credentials from the application you created at dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Item IDs from the MeuPluggy connector (200), comma-separated.
# Copy them in the Dashboard: your application > "Copiar Item ID".
PLUGGY_ITEM_IDS=

# Token MCP clients must send in the Authorization: Bearer <token> header.
# Generate one with: openssl rand -base64 48
MCP_BEARER_TOKEN=

# The process listens on loopback ONLY. Tailnet exposure is handled by
# `tailscale serve`, never by binding to 0.0.0.0.
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8787

# Row ceiling per response before truncating with a warning.
MCP_MAX_ROWS=800
