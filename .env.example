# Credentials from the application you created at dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Item IDs from the MeuPluggy connector (200), comma-separated.
# Copy them in the Dashboard: your application > "Copiar Item ID".
PLUGGY_ITEM_IDS=

# Optional. Names a connection whose accounts do not identify the bank: labels are
# normally derived from account names, which fails when every account is called
# "Conta Corrente". Format: <item id>=<name>, comma-separated. A name cannot
# contain a comma, and an item id here must also appear in PLUGGY_ITEM_IDS.
PLUGGY_ITEM_LABELS=

# Token MCP clients must send in the Authorization: Bearer <token> header.
# Generate one with: openssl rand -base64 48
MCP_BEARER_TOKEN=

# The process listens on loopback ONLY. Tailnet exposure is handled by
# `tailscale serve`, never by binding to 0.0.0.0.
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8787

# Row ceiling per response before truncating with a warning.
MCP_MAX_ROWS=800
