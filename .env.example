# Credenciais da aplicação criada em dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Item IDs do conector MeuPluggy (200), separados por vírgula.
# Copie no Dashboard > sua aplicação > "Copiar Item ID".
PLUGGY_ITEM_IDS=

# Token que os clientes MCP devem enviar em Authorization: Bearer <token>
# Gere com: openssl rand -base64 48
MCP_BEARER_TOKEN=

# O processo escuta SOMENTE em loopback. A exposição no tailnet é feita por
# `tailscale serve`, nunca por bind em 0.0.0.0.
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8787

# Teto de linhas por resposta antes de truncar com aviso.
MCP_MAX_ROWS=800
